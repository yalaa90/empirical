# Host ports for the combined Empirical stack.
API_PORT=8049
MOCK_API_PORT=8001
WEB_PORT=5175
STOREFRONT_PORT=5176

# llama.cpp model. The first `docker compose up` downloads this GGUF.
QWEN_MODEL_REPO=Qwen/Qwen1.5-1.8B-Chat-GGUF
QWEN_MODEL_FILE=qwen1_5-1_8b-chat-q4_k_m.gguf
LLAMA_THREADS=4

# Browser-facing origins baked into the storefront build.
# These must match the host ports above; rebuild `storefront` if you change them.
VITE_EMPIRICAL_WEB_URL=http://localhost:5175
VITE_STOREFRONT_ORIGIN=http://localhost:5176

# Optional empirical-api settings (passed through via env_file).
LLM_STRUCTURED_MODE=auto
LLM_MAX_CONCURRENCY=1
LLM_QUEUE_TIMEOUT_S=12
CONFIRM_TTL_S=120
LOG_LEVEL=INFO
LOG_MESSAGES=true

# --- Public deployment behind Traefik (VPS) ---
# Set these in the .env file on the server. Do not commit that file.
WEB_DOMAIN=chat.example.com
STOREFRONT_DOMAIN=shop.example.com
TRAEFIK_NETWORK=traefik
TRAEFIK_CERT_RESOLVER=letsencrypt
# On the VPS, change the two browser-facing origins above to the public https URLs:
# VITE_EMPIRICAL_WEB_URL=https://chat.example.com
# VITE_STOREFRONT_ORIGIN=https://shop.example.com
