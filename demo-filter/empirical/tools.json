{
  "version": 1,
  "tools": [
    {
      "name": "search_products",
      "description": "Search the store catalog by text, category, color, and maximum price. Use for finding, filtering, or browsing products. Rules: (1) query is always required: use the user's product words, or 'all' for browse-everything requests. (2) Set category only when the request maps to exactly one category (synonyms: sneakers/trainers/boots/sandals=shoes; tee/shirt=tshirt; sweatshirt/pullover/jumper=hoodie; cap/beanie=hat; bag/belt/watch/sunglasses/scarf/gloves=accessory). (3) Set color only for exactly one supported color; unsupported or multiple colors stay in query. (4) Set max_price only for an upper limit (under/below/up to/at most/budget/between X and Y -> Y); ignore lower limits and words like cheap or expensive. (5) Fix obvious typos in query. (6) Never invent filters the user did not ask for.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "category": {
            "type": "string",
            "enum": [
              "tshirt",
              "hoodie",
              "shoes",
              "hat",
              "accessory"
            ]
          },
          "color": {
            "type": "string",
            "enum": [
              "red",
              "blue",
              "black",
              "white",
              "green",
              "yellow"
            ]
          },
          "max_price": {
            "type": "number",
            "minimum": 1
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "destructive": false,
      "executable": true,
      "method": "GET",
      "url": "/actions/search-products",
      "success_template": "Found {result[count]} product(s).",
      "confirm_summary": null,
      "examples": [
