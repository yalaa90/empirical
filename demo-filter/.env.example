# Empirical web chat client (empirical-clients/web)
VITE_EMPIRICAL_WEB_URL=http://localhost:5175

# Origin allowed to receive postMessage events. Derived from VITE_EMPIRICAL_WEB_URL
# when omitted.
# VITE_EMPIRICAL_WEB_ORIGIN=http://localhost:5175

# The storefront origin shared with the embedded chat client.
VITE_STOREFRONT_ORIGIN=http://localhost:5176

# Demo product API used by empirical-api as BASE_URL.
MOCK_API_PORT=8003
