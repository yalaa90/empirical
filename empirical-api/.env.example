# Docker Compose model download (ignored by the app itself).
# The first `docker compose up` downloads this GGUF into the `models` volume.
QWEN_MODEL_REPO=Qwen/Qwen1.5-1.8B-Chat-GGUF
QWEN_MODEL_FILE=qwen1_5-1_8b-chat-q4_k_m.gguf

API_PORT=8049
LLM_URL=http://127.0.0.1:8080
LLM_MODEL=qwen1.5-1.8b-chat
# Optional key if llama-server was launched with --api-key. This is NOT the user's API token.
LLM_API_KEY=
LLM_STRUCTURED_MODE=auto
LLM_MAX_CONCURRENCY=1
LLM_QUEUE_TIMEOUT_S=12

BASE_URL=http://127.0.0.1:8001
TIMEOUTS={"llm":30,"api":5,"connect":2,"health":2}
CONFIRM_TTL_S=120

TOOLS_PATH=./tools.json
PROMPT_EXAMPLE_LIMIT=2
MAX_MESSAGE_CHARS=500

LOG_LEVEL=INFO
LOG_MESSAGES=true

# N_THREADS is not an app setting. Set llama-server's -t flag to the number
# of physical cores (e.g. 4), not logical threads.
